<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The demo estate (embed.py serve --demo) on 127.0.0.1:8767, beside the real app on 8766.
     Runs from its own worktree, so the demo's branch never changes the code the real app runs. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jflam.photo-search-demo</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string><string>run</string><string>--quiet</string>
    <string>/Users/jflam/src/photo-estate-demo/photo-estate/embed.py</string>
    <string>serve</string><string>--demo</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/jflam/src/photo-estate-demo/photo-estate</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>HF_HUB_OFFLINE</key><string>1</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/Users/jflam/Library/Logs/photo-search-demo.log</string>
  <key>StandardErrorPath</key><string>/Users/jflam/Library/Logs/photo-search-demo.log</string>
</dict>
</plist>
