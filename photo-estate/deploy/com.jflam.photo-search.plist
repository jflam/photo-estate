<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jflam.photo-search</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/uv</string><string>run</string><string>--quiet</string>
    <string>/Users/jflam/src/photo-estate/photo-estate/embed.py</string>
    <string>--db</string><string>/Volumes/estate/estate.db</string>
    <string>serve</string>
    <string>--store</string><string>/Volumes/estate/store</string>
    <string>--fast-cache</string><string>/Users/jflam/Library/Caches/photo-estate</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/jflam/src/photo-estate/photo-estate</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>HF_HUB_OFFLINE</key><string>1</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/Users/jflam/Library/Logs/photo-search.log</string>
  <key>StandardErrorPath</key><string>/Users/jflam/Library/Logs/photo-search.log</string>
</dict>
</plist>
